    "@turf/dissolve": "^7.3.0",
    "pinia": "^3.0.3",
    "sockjs-client": "^1.6.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.15",
    "@tsconfig/node22": "^22.0.2",
    "@turf/union": "^7.3.0",
    "@types/jsdom": "^27.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.18.11",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/eslint-plugin": "^1.3.23",
    "@vue/eslint-config-prettier": "^10.2.0",
