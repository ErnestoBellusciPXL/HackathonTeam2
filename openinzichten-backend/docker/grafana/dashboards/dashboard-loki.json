        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"syslog\"}"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true
