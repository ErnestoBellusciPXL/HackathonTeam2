  "panels": [
    {
      "id": 1,
      "type": "logs",
      "title": "Docker logs (job = docker_services)",
      "datasource": "$ds_loki",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker_services\"}"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true
      }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "Docker errors (via JSON level=\"error\")",
      "datasource": "$ds_loki",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"docker_services\"} | json | level=\"error\""
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": true
      }
    },
    {
